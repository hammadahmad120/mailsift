# --- stdio transport ONLY (Claude Code, Cursor, local scripts) ---
# A stdio client launches mailsift as a child process and has no headers, so the mailbox
# credentials come from this environment. Over HTTP every request carries its own X-Mail-Token
# (and optional X-Mail-Provider) and the server NEVER reads the five values below.
# For an HTTP-only deployment, delete this whole block.
MAIL_PROVIDER=gmail
# Option 1: a Google OAuth access token with the gmail.readonly scope. Expires after about an hour.
MAIL_TOKEN=
# Option 2: the refresh trio. The server mints access tokens from it in memory and re-mints before expiry.
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- http transport (apps, remote clients) ---
# Comma separated. Required in --http mode; the server refuses to start without it.
# Generate one per calling service with `openssl rand -hex 32`; callers send it as Authorization: Bearer <key>.
MCP_SERVER_KEYS=
PORT=3000

# --- logging ---
# JSON lines on stderr. One of debug, info, warn, error. Tokens are redacted before anything is written.
LOG_LEVEL=info

# --- limits (defaults shown) ---
MAX_RANGE_DAYS=365
MAX_PAGE_SIZE=100
MAX_COLLECT_MESSAGES=200
# Most message ids collect_mail walks for order "oldest_first" before taking the earliest max_messages.
MAX_SEARCH_IDS=2000
MAX_ATTACHMENT_BYTES=10485760
MAX_MESSAGE_CHARS=50000
MAX_ATTACHMENT_CHARS=100000
MAX_TOTAL_CHARS=2000000
FETCH_CONCURRENCY=5
GMAIL_TIMEOUT_MS=20000
SCOPE_CACHE_TTL_MS=600000
